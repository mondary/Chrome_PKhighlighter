{
  "manifest_version": 3,
  "name": "PK Highlighter",
  "version": "2026.10.2",
  "version_name": "2026.10.2",
  "homepage_url": "https://mondary.github.io/Chrome_PKhighlighter/store/",
  "description": "Highlight keywords with custom colors. Made by PK-Labs.",
  "short_name": "PK-Labs HL",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon2.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon2.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["keyword-highlighter.js"],
      "run_at": "document_start"
    }
  ]
}
